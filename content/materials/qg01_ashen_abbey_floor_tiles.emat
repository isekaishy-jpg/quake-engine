format 1 material

surface {
    base = textures/qg01_ashen_abbey_floor_tiles.png
    world_size = 256 256
    repeat = both
    normal = textures/qg01_ashen_abbey_floor_tiles_normal.png
    specular = textures/qg01_ashen_abbey_floor_tiles_specular.png
    specular_strength = 1
    gloss = 12
    shading = lit
    alpha = opaque
    kind = solid
    layer { base = textures/qg01_ashen_abbey_wall_damp.png mask = paint }
    layer { base = textures/qg01_ashen_abbey_rock.png mask = paint }
}
