format 1 material

surface {
    base = textures/qg01_ashen_abbey_rock.png
    world_size = 232 232
    repeat = both
    normal = textures/qg01_ashen_abbey_rock_normal.png
    specular = textures/qg01_ashen_abbey_rock_specular.png
    specular_strength = 1
    gloss = 12
    shading = lit
    alpha = opaque
    kind = solid
    hex = true
    layer { base = textures/qg01_ashen_abbey_wall_damp.png mask = paint }
    layer { base = textures/qg01_ashen_abbey_floor_flags.png mask = paint }
}
