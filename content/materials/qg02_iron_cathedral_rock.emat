format 1 material

surface {
    base = textures/qg02_iron_cathedral_rock.png
    world_size = 232 232
    repeat = both
    normal = textures/qg02_iron_cathedral_rock_normal.png
    specular = textures/qg02_iron_cathedral_rock_specular.png
    specular_strength = 1
    gloss = 48
    shading = lit
    alpha = opaque
    kind = solid
    hex = true
    layer { base = textures/qg02_iron_cathedral_wall_damp.png mask = paint }
    layer { base = textures/qg02_iron_cathedral_floor_flags.png mask = paint }
}
