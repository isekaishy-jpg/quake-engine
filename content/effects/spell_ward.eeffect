format 1 effect

# A ward on the floor: a turning circle of runes, a light of its own, and motes rising from its
# edge. It goes on until it's stopped.
emitter circle {
    kind = decal
    blend = add
    image = textures/fx_circle.png
    rate = 2
    life = 2.4
    size = 170
    color = 0 0 0 0 0 0.3 0.5 0.9 2.2 1 0.7 0.5 0.9 2.2 1 1 0 0 0 0
}
emitter motes {
    blend = add
    image = textures/fx_glow.png
    rate = 40
    shape = ring
    radius = 72
    life = 1 1.8
    speed = 26 60
    direction = 0 0 1
    spread = 8
    turbulence = 14
    size = 0 5 1 0
    color = 0 0.3 0.6 1.8 0 0.2 0.5 0.9 2.2 1 1 0.2 0.3 1.2 0
}
emitter glow {
    kind = light
    rate = 8
    life = 0.3
    reach = 200
    color = 0 0.25 0.45 1.2 1 1 0.15 0.3 0.8 0.4
}
