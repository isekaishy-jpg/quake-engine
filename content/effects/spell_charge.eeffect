format 1 effect

# Light being drawn in to something about to be let go: motes pulled round and in, and a glow that
# grows. Stop it when the spell goes.
emitter motes {
    blend = add
    image = textures/fx_glow.png
    rate = 160
    shape = ring
    radius = 90
    life = 0.7 1.1
    speed = 0 20
    size = 0 2 0.3 7 1 1
    color = 0 0.3 0.6 2 0 0.4 0.4 0.8 2.4 1 1 1 1.2 3 0.6
    force { kind = attract strength = 420 reach = 200 }
    force { kind = vortex axis = 0 0 1 strength = 260 inward = 60 }
}
emitter heart {
    blend = add
    image = textures/fx_star.png
    rate = 14
    life = 0.5
    spin = -90 90
    rotation = 0 360
    size = 0 8 0.5 42 1 14
    color = 0 0.4 0.7 2 0 0.5 0.6 0.9 2.4 0.7 1 0.4 0.7 2 0
}
emitter glow {
    kind = light
    rate = 10
    life = 0.25
    reach = 180
    color = 0 0.4 0.6 1.6 1 1 0.2 0.3 0.8 0
}
