format 1 effect

# What goes with something thrown: start it following what flies. A bright head, a tail of light,
# and motes left behind.
emitter head {
    blend = add
    image = textures/fx_star.png
    rate = 40
    life = 0.14
    rotation = 0 360
    spin = -200 200
    size = 26
    color = 0 2 1 3.5 1 1 0.4 0.8 2 0
}
emitter tail {
    kind = ribbon
    blend = add
    rate = 30
    life = 0.3
    size = 9
    color = 0 1.4 0.8 3 1 1 0.2 0.4 1.5 0
}
emitter motes {
    blend = add
    image = textures/fx_glow.png
    rate = 70
    shape = ball
    radius = 6
    life = 0.4 0.9
    speed = 6 30
    turbulence = 40
    size = 0 5 1 0
    color = 0 0.8 0.5 2.4 1 1 0.2 0.3 1.4 0
}
emitter glow {
    kind = light
    rate = 16
    life = 0.14
    reach = 170
    color = 0 0.5 0.4 1.6 1 1 0.2 0.3 1 0.3
}
