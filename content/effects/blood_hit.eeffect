format 1 effect

# A wound: drops that fall and go on what they land on, and a small dark puff.
emitter drops {
    image = textures/fx_glow.png
    burst = 18
    life = 0.4 0.9
    speed = 50 190
    spread = 70
    gravity = 0.9
    size = 0 7 1 4
    collide = die
    color = 0.55 0.03 0.02 1
    lit = true
}
emitter puff {
    image = textures/fx_puff.png
    burst = 3
    life = 0.25 0.45
    speed = 10 30
    rotation = 0 360
    size = 0 12 1 34
    color = 0 0.4 0.03 0.02 0.8 1 0.24 0.02 0.01 0
    soft = 6
    lit = true
}
