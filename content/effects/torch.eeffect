    direction = 0 0 1
    spread = 4
    rotation = -8 8
    size = 0 18 0.3 30 1 16
    color = 0 1.6 0.8 0.25 0 0.2 1.6 0.8 0.25 0.9 1 0.8 0.2 0.04 0
}
