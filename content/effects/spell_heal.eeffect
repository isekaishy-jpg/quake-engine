format 1 effect

# Being mended: soft light rising round something, and small stars going up through it.
emitter rising {
    blend = add
    image = textures/fx_glow.png
    rate = 70
    shape = ring
    radius = 26
    life = 0.8 1.4
    speed = 40 80
    direction = 0 0 1
    spread = 6
    size = 0 8 1 2
    color = 0 0.3 1.4 0.5 0 0.3 0.5 2 0.7 1 1 0.2 1 0.4 0
    force { kind = vortex axis = 0 0 1 strength = 80 }
}
emitter stars {
    blend = add
    image = textures/fx_star.png
    rate = 9
    shape = disc
    radius = 24
    life = 0.7 1.1
    speed = 30 60
    direction = 0 0 1
    spread = 5
    rotation = 0 360
    spin = -120 120
    size = 0 3 0.5 13 1 0
    color = 0 1 2.6 1 1 1 0.4 2 0.6 0
}
emitter glow {
    kind = light
    rate = 8
    life = 0.3
    reach = 150
    color = 0 0.3 1 0.4 1 1 0.15 0.5 0.2 0.3
}
