format 1 effect

# Specks and small bubbles round the view under water. Name it as a water's `view_effect`.
emitter motes {
    image = textures/fx_glow.png
    rate = 120
    shape = ball
    radius = 260
    life = 2 4
    speed = 2 10
    turbulence = 12
    size = 0 0 0.2 3.5 0.8 3.5 1 0
    color = 0.8 0.9 0.85 0.5
    soft = 4
    lit = true
}
emitter bubbles {
    image = textures/fx_ring.png
    rate = 5
    shape = ball
    radius = 200
    life = 1.5 3
    speed = 30 60
    direction = 0 0 1
    spread = 6
    turbulence = 30
    size = 0 2 0.2 6 1 8
    color = 0 0.9 1 1 0 0.1 0.9 1 1 0.5 1 0.9 1 1 0
}
