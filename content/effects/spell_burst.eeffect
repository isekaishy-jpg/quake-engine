format 1 effect

# A spell landing: a star, a ring going out, and motes flung from it that slow and hang.
emitter star {
    blend = add
    image = textures/fx_star.png
    burst = 3
    life = 0.3 0.45
    rotation = 0 360
    spin = -120 120
    size = 0 40 0.3 150 1 60
    color = 0 3 2 5 1 1 0.4 0.8 2 0
}
emitter ring {
    blend = add
    image = textures/fx_ring.png
    burst = 1
    life = 0.4
    size = 0 30 1 320
    color = 0 1.2 1 3 0.9 1 0.3 0.5 1.6 0
}
emitter motes {
    blend = add
    image = textures/fx_glow.png
    burst = 90
    shape = ball
    radius = 10
    outward = true
    life = 0.7 1.5
    speed = 160 420
    drag = 3.5
    gravity = 0.04
    size = 0 7 1 0
    color = 0 1 0.8 3 1 1 0.2 0.4 1.6 0
}
emitter flash {
    kind = light
    burst = 1
    life = 0.35
    reach = 420
    color = 0 1.6 1.2 3.5 1 1 0.3 0.4 1.4 0
}
