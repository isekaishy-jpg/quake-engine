format 1 effect

# Ash and sparks going by on the wind, in compute, for what's burning or has burned.
emitter ash {
    gpu = sim
    image = textures/fx_puff.png
    rate = 900
    shape = box
    half_size = 800 800 300
    life = 5 8
    speed = 8 24
    direction = 0 0 -1
    spread = 40
    turbulence = 30
    rotation = 0 360
    spin = -120 120
    size = 0 0 0.1 5 0.9 3 1 0
    color = 0.09 0.08 0.08 0.8
    soft = 4
    lit = true
    force { kind = wind blowing = 60 18 -8 gusts = 0.9 }
}
emitter embers {
    gpu = sim
    blend = add
    image = textures/fx_glow.png
    rate = 40
    shape = box
    half_size = 800 800 300
    life = 2.5 5
    speed = 10 30
    direction = 0 0 1
    spread = 30
    turbulence = 50
    size = 0 3 1 1
    color = 0 3 1.1 0.2 0 0.15 3 1.1 0.2 1 1 0.8 0.15 0.02 0
    force { kind = wind blowing = 60 18 12 gusts = 0.9 }
}
