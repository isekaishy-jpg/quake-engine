format 1 map

# Nine tiles on a grid, for a world in parts. Each is a file of its own.
entity world {
    type = worldspawn
    sun_intensity = 120
    sun_crisp = true
    ambient = 36
    light_spacing = 32
    cell_size = 1024
    wake_reach = 1800
}
sky {
    zenith = 0.16 0.34 0.62
    horizon = 0.85 0.8 0.72
    sun_direction = 0.4 0.3 0.85
    clouds { coverage = 0.4 }
}
tile_grid { size = 2048 }
tile { x = 0 y = 0 file = "tile_world/0_0" }
tile { x = 1 y = 0 file = "tile_world/1_0" }
tile { x = 2 y = 0 file = "tile_world/2_0" }
tile { x = 0 y = 1 file = "tile_world/0_1" }
tile { x = 1 y = 1 file = "tile_world/1_1" }
tile { x = 2 y = 1 file = "tile_world/2_1" }
tile { x = 0 y = 2 file = "tile_world/0_2" }
tile { x = 1 y = 2 file = "tile_world/1_2" }
tile { x = 2 y = 2 file = "tile_world/2_2" }
entity start { type = info_player_start origin = 1024 400 24 angle = 90 }
