format 1 map

# Open sky over a yard: gradient horizon, sun, and procedural clouds.
sky {
    zenith = 0.12 0.28 0.6
    horizon = 0.8 0.78 0.72
    ground = 0.32 0.3 0.28
    sun_direction = 0.5 0.4 0.5
    clouds {
        coverage = 0.55
        speed = 0.01 0.004
        scale = 1
    }
}
brush { material = stone cuboid = -2048 -2048 -32 2048 2048 0 }
brush { material = brick cuboid = -256 256 0 256 288 256 }
brush { material = brick cuboid = -256 -256 0 -224 256 128 }
entity start { type = info_player_start origin = 0 0 24 angle = 90 }
