format 1 map

# tile_world's yards, 16 by 16, to show streaming. Written by build_wide_world.py.
entity world {
    type = worldspawn
    sun_intensity = 120
    sun_crisp = true
    ambient = 36
    light_spacing = 32
    cell_size = 1024
    wake_reach = 1800
}
sky {
    zenith = 0.16 0.34 0.62
    horizon = 0.85 0.8 0.72
    sun_direction = 0.4 0.3 0.85
    clouds { coverage = 0.4 }
}
tile_grid { size = 2048 }
